TZ={{ soft_serve_environment_variables_tz }}

SOFT_SERVE_NAME={{ soft_serve_hostname }}
SOFT_SERVE_SSH_LISTEN_ADDR=:{{ soft_serve_container_bind_port }}
SOFT_SERVE_SSH_PUBLIC_URL={{ soft_serve_ssh_public_url }}
SOFT_SERVE_INITIAL_ADMIN_KEYS={{ soft_serve_initial_admin_key }}

{# Both are overrides that Soft Serve consults on every access check, not seed
   values, so they are only emitted when the operator asked for them. Emitting
   them unconditionally would permanently disable the `settings anon-access` and
   `settings allow-keyless` commands. #}
{% if soft_serve_anon_access | string | length > 0 %}
SOFT_SERVE_ANON_ACCESS={{ soft_serve_anon_access }}
{% endif %}
{% if soft_serve_allow_keyless | string | length > 0 %}
SOFT_SERVE_ALLOW_KEYLESS={{ soft_serve_allow_keyless | bool | lower }}
{% endif %}

{# TODO: make these features configurable #}
SOFT_SERVE_GIT_ENABLED=false
SOFT_SERVE_HTTP_ENABLED=false
SOFT_SERVE_STATS_ENABLED=false
SOFT_SERVE_LFS_ENABLED=false
SOFT_SERVE_LFS_SSH_ENABLED=false

{# Note: the following SOFT_SERVE_* vars are kept for backward compatibility only #}
SOFT_SERVE_HOST={{ soft_serve_hostname }}
SOFT_SERVE_PORT={{ soft_serve_container_bind_port }}
SOFT_SERVE_INITIAL_ADMIN_KEY={{ soft_serve_initial_admin_key }}

{{ soft_serve_environment_variables_additional_variables }}
